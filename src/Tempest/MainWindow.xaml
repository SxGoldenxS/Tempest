<Window x:Class="Tempest.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tempest" Width="1080" Height="780" MinWidth="900" MinHeight="660"
 ThemeMode="Dark" WindowStartupLocation="CenterScreen" Background="#142333"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Foreground="#EAF2F9" Icon="Assets/tempest.ico">
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B3043" Offset="0"/><GradientStop Color="#152333" Offset="0.6"/><GradientStop Color="#1B293B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="12,20,12,16">
   <Grid DockPanel.Dock="Top" Margin="12,0,0,28">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="Assets/tempest.png" Width="38" Height="38" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="tempest" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Spicetify utility" FontSize="11" Foreground="#9CB4C8" Margin="0,2,0,0"/></StackPanel>
   </Grid>
   <StackPanel DockPanel.Dock="Bottom" Margin="4,0">
    <Button Style="{StaticResource Nav}" Click="Docs_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="Help &amp; documentation" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
    <TextBlock x:Name="VersionLabel" Foreground="#8FB8CE" FontSize="11" Margin="15,14,0,0"/>
   </StackPanel>
   <StackPanel x:Name="Navigation">
    <Button Tag="overview" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></Button>
    <Button Tag="install" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/><TextBlock Text="Install &amp; update" VerticalAlignment="Center"/></StackPanel></Button>
    <Button Tag="repair" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Repair" VerticalAlignment="Center"/></StackPanel></Button>
    <Button Tag="recovery" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Recovery" VerticalAlignment="Center"/></StackPanel></Button>
    <Button Tag="activity" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Activity" VerticalAlignment="Center"/></StackPanel></Button>
    <Border Height="1" Background="#284155" Margin="12,16"/>
    <Button Tag="appearance" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
   </StackPanel>
  </DockPanel>
  <Border Grid.Column="1" CornerRadius="10,0,0,0" Background="#8A101F2F" BorderBrush="#344A5C" BorderThickness="1,1,0,0" Margin="0,8,0,0">
   <Grid Margin="30,25,30,15">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
     <StackPanel><TextBlock x:Name="PageEyebrow" Visibility="Collapsed"/><TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" ToolTip="Refresh installation status" Click="Refresh_Click" Margin="0,0,8,0" AutomationProperties.Name="Refresh"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14"/></Button>
      <Button Content="Open Spotify" Style="{StaticResource ActionButton}" Click="OpenSpotify_Click"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1">
    <Border x:Name="UpdateNotice" Visibility="Collapsed" Background="#29495F" BorderBrush="#91D5F3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
     <DockPanel><Button Content="Get update" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="UpdateTempest_Click" Margin="12,0,0,0"/><TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    </Border>
    <Border x:Name="SpicetifyUpdateNotice" Visibility="Collapsed" Background="#29495F" BorderBrush="#91D5F3" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
     <DockPanel><Button Content="Review Spicetify update" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="UpdateSpicetify_Click" Margin="12,0,0,0"/><TextBlock x:Name="SpicetifyUpdateText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    </Border>
    <Border x:Name="Notice" Background="#253F54" BorderBrush="#345267" BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,0,0,20">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#91D5F3" VerticalAlignment="Center"/><TextBlock x:Name="NoticeText" Grid.Column="1" Text="Checking your installation…" FontSize="12" Foreground="#BCD5E5" TextWrapping="Wrap"/></Grid>
    </Border>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"><StackPanel x:Name="PageContent"/></ScrollViewer>
    <Border x:Name="OperationPanel" Grid.Row="3" Visibility="Collapsed" Background="#21384B" BorderBrush="#3A576C" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
     <StackPanel><Grid><TextBlock x:Name="OperationTitle" Text="Ready" FontWeight="SemiBold" FontSize="13"/><Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="10,4" Visibility="Collapsed" Click="Cancel_Click"/></Grid><TextBlock x:Name="OperationDetail" Style="{StaticResource Caption}" Margin="0,5,0,0"/><ProgressBar x:Name="Progress" Height="3" Foreground="#91D5F3" Background="#263F52" Visibility="Collapsed" Margin="0,12,0,0"/></StackPanel>
    </Border>
    <Grid Grid.Row="4" Margin="0,20,0,0"><TextBlock x:Name="FooterStatus" Text="Ready" Foreground="#8AA6BB" FontSize="11"/><TextBlock Text="No telemetry" Foreground="#7893A9" FontSize="11" HorizontalAlignment="Right"/></Grid>
   </Grid>
  </Border>
  <Grid x:Name="ReviewOverlay" Grid.ColumnSpan="2" Background="#A608101A" Visibility="Collapsed">
   <Border Width="480" MaxHeight="590" Background="#203447" BorderBrush="#546C80" BorderThickness="1" CornerRadius="8" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ReviewTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="ReviewBody" FontSize="13" LineHeight="22" Foreground="#C1D1DF" TextWrapping="Wrap"/><Border Background="#2B4357" CornerRadius="5" Padding="12" Margin="0,20"><TextBlock x:Name="ReviewFootnote" FontSize="12" Foreground="#ABD8EF" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Go back" Style="{StaticResource ActionButton}" Click="DismissReview_Click" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Content="Continue" Style="{StaticResource Primary}" Click="Confirm_Click"/></StackPanel></StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
